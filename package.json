{
  "name": "slidev-theme-watabegg",
  "version": "1.1.4",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "author": "watabegg",
  "description": "A personal Slidev theme for watabegg.",
  "license": "MIT",
  "homepage": "https://github.com/watabegg/slidev-theme-watabegg#readme",
  "bugs": {
    "url": "https://github.com/watabegg/slidev-theme-watabegg/issues"
  },
  "keywords": [
    "slidev-theme",
    "slidev",
    "watabegg",
    "personal-theme"
  ],
  "engines": {
    "node": ">=20.12.0",
    "slidev": ">=52.15.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/watabegg/slidev-theme-watabegg"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "components",
    "layouts",
    "setup",
    "styles",
    "utils",
    "global-bottom.vue"
  ],
  "scripts": {
    "build": "slidev build example.md",
    "dev": "slidev example.md",
    "dev:polling": "CHOKIDAR_USEPOLLING=1 slidev example.md",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm pack --dry-run",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "dependencies": {
    "@slidev/types": "^52.15.2",
    "katex": "^0.16.47",
    "marked": "^18.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@slidev/cli": "^52.15.2",
    "@slidev/client": "^52.15.2",
    "bumpp": "^11.1.0",
    "playwright-chromium": "^1.60.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.34",
    "vue-tsc": "^3.3.1"
  },
  "//": "Learn more: https://sli.dev/guide/write-theme.html",
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "background": "#FFFFFF",
      "fonts": {
        "sans": "M PLUS 2",
        "mono": "Fira Code"
      },
      "lineNumbers": false
    }
  }
}
